# ArcSLA frontend configuration. Public values only: every VITE_ variable is shipped to the browser.
# Never put a private key, seed phrase or API secret here.

# Network the site opens on: "testnet" (default) or "mainnet". Visitors can switch with the header selector.
# VITE_DEFAULT_NETWORK=testnet

# Contract addresses and deployment blocks are registered per network in src/lib/networks.ts.
# Do NOT set VITE_ARCSLA_ADDRESS: a value that differs from the registered deployment disables every transaction.

# Do NOT set VITE_USDC_ADDRESS. The app uses the official USDC address for the selected network from
# src/onchain-facts.ts; an override is reported as a configuration problem.
# VITE_USDC_ADDRESS=

# Optional proof-of-concept limits, applied on mainnet only and enforced by this app only:
# VITE_MAX_AGREEMENT_USDC=0.01
# VITE_MAX_DEADLINE_HOURS=2

# Only for the Foundry deploy script. Never commit a value, and prefer a Foundry keystore (--account)
# or a hardware wallet over a raw private key.
# USDC_ADDRESS=
# RPC_URL=
