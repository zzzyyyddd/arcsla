# Arc Mainnet build profile. Copy to .env.mainnet (git-ignored) and use with `bun run dev:mainnet`.
# For a production build that opens on mainnet, set the same variables where the site is built.
# Public values only. NEVER put a private key, seed phrase or API secret in any env file.

# Which network the site opens on. Visitors can still switch with the Testnet / Mainnet selector.
# Leave unset (or "testnet") for a site that opens on Arc Testnet.
VITE_DEFAULT_NETWORK=mainnet

# The mainnet contract (0x5F040Bc6...CbdAC, block 28741163) and the testnet contract are registered in
# src/lib/networks.ts, one entry per network. Do NOT set VITE_ARCSLA_ADDRESS: a value that differs from the
# registered deployment is reported as a configuration problem and disables every transaction.

# Do not set VITE_USDC_ADDRESS: the app uses the official USDC address (0x3600...0000) from its registry,
# and treats an override on mainnet as a configuration problem.

# Safety rails for a controlled proof of concept. Enforced by this app only (the contract has no limits)
# and applied on mainnet only.
VITE_MAX_AGREEMENT_USDC=0.01
VITE_MAX_DEADLINE_HOURS=2
